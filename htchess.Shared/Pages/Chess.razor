@page "/"
@page "/chess"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@inject IJSRuntime JS
@using htchess.Shared.Chess

<PageTitle>htchess — cờ vua 3D</PageTitle>

<div class="chess-layout">
    <div class="board-area">
        <canvas @ref="_canvas" class="board-canvas"></canvas>

        @if (ClockOn)
        {
            <div class="clock clock-top @(TopClockHot ? "hot" : "")">@Fmt(TopMs)</div>
            <div class="clock clock-bottom @(BottomClockHot ? "hot" : "")">@Fmt(BottomMs)</div>
        }

        @if (_session.AwaitingPromotion)
        {
            <div class="promo-overlay" @onclick="CancelPromo">
                <div class="promo-box" @onclick:stopPropagation>
                    <p>Phong cấp thành:</p>
                    <div class="promo-btns">
                        <button @onclick='() => PickPromo("Q")'>♕ Hậu</button>
                        <button @onclick='() => PickPromo("R")'>♖ Xe</button>
                        <button @onclick='() => PickPromo("B")'>♗ Tượng</button>
                        <button @onclick='() => PickPromo("N")'>♘ Mã</button>
                    </div>
                </div>
            </div>
        }
        <div class="eval-bar" title="Đánh giá của máy (+ trắng / − đen)">
            <div class="eval-fill" style="height:@(EvalPct())%"></div>
        </div>
        <span class="eval-num">@EvalText()</span>

        @if (_aiThinking)
        {
            <div class="ai-badge">Máy đang nghĩ…</div>
        }
        @if (_session.IsGameOver)
        {
            <div class="end-overlay">
                <div class="end-box">
                    <div class="end-result">@_session.ResultTag</div>
                    <div class="end-reason">@_session.GameOverReason</div>
                    <button class="btn btn-primary" @onclick="NewGame">Chơi lại</button>
                </div>
            </div>
        }
        <div class="panel-wrap @(_panelPinned ? "pinned" : "")">
            <button class="panel-tab" @onclick="TogglePanel" title="Bảng điều khiển">
                <span class="tab-status">@StatusText()</span><span class="tab-chev">‹</span>
            </button>
            <div class="side-panel">
                <div class="sheet-handle" @onclick="TogglePanel"><span class="sheet-grip"></span></div>
        <div class="panel-row">
            <select @bind="_modePick" class="form-select form-select-sm" title="Chế độ">
                <option value="2p">2 người</option>
                <option value="ai-w">vs Máy (Trắng)</option>
                <option value="ai-b">vs Máy (Đen)</option>
            </select>
            <select @bind="_tcPick" @bind:after="ResetClock" class="form-select form-select-sm" title="Thời gian">
                <option value="none">Không giờ</option>
                <option value="1+0">1+0 siêu chớp</option>
                <option value="3+0">3+0 chớp</option>
                <option value="3+2">3+2 chớp</option>
                <option value="5+0">5+0 chớp</option>
                <option value="5+3">5+3 chớp</option>
                <option value="10+0">10+0 nhanh</option>
            </select>
        </div>

        <div class="status">@StatusText()</div>

        <div class="icon-row">
            <button class="ibtn @(_confirmNew ? "ibtn-warn" : "ibtn-primary")" @onclick="NewGameClick" title="Ván mới">✚</button>
            <button class="ibtn @(_confirmResign ? "ibtn-danger" : "")"
                    @onclick="ResignClick" disabled="@_session.IsGameOver" title="Đầu hàng">⚑</button>
            <button class="ibtn @(_confirmDraw ? "ibtn-warn" : "")"
                    @onclick="DrawClick" disabled="@_session.IsGameOver" title="Cầu hòa">½</button>
            <button class="ibtn" @onclick="Undo" disabled="@(_session.PlyCount == 0 || _aiThinking)" title="Hoàn nước">↩</button>
            <button class="ibtn" @onclick="Flip" title="Xoay bàn">⇄</button>
            <button class="ibtn @(_copied ? "ibtn-ok" : "")" @onclick="CopyPgn" disabled="@(_session.PlyCount == 0)" title="Sao chép PGN">@(_copied ? "✓" : "⧉")</button>
        </div>
        @if (_confirmNew)
        {
            <div class="hint">Bấm ✚ lần nữa để bắt đầu ván mới.</div>
        }
        @if (_confirmResign)
        {
            <div class="hint">Bấm ⚑ lần nữa để xác nhận đầu hàng.</div>
        }
        @if (_confirmDraw)
        {
            <div class="hint">Bấm ½ lần nữa để xác nhận hòa.</div>
        }
        @if (_drawDeclined)
        {
            <div class="hint">Máy từ chối hòa.</div>
        }

        <div class="captured">
            <div><span class="cap-side">Trắng</span> @(CapLine(_session.CapturedByWhite(), MaterialDiff() > 0 ? MaterialDiff() : 0))</div>
            <div><span class="cap-side">Đen</span> @(CapLine(_session.CapturedByBlack(), MaterialDiff() < 0 ? -MaterialDiff() : 0))</div>
        </div>

        <div class="movelist">
            @{ var hist = _session.History; }
            @if (hist.Count == 0)
            {
                <div class="move-empty">Chưa có nước đi</div>
            }
            @for (var i = 0; i < hist.Count; i += 2)
            {
                var w = i; var b = i + 1;
                <div class="move-pair">
                    <span class="move-no">@(i / 2 + 1).</span>
                    <span class="move-san @(_viewPly == w + 1 ? "cur" : "")" @onclick="() => ViewPly(w + 1)">@hist[i].San</span>
                    <span class="move-san @(_viewPly == b + 1 ? "cur" : "")" @onclick="() => { if (b < hist.Count) _ = ViewPly(b + 1); }">@(b < hist.Count ? hist[b].San : "")</span>
                </div>
            }
        </div>
        <div class="btn-row nav-row">
            <button class="ibtn ibtn-sm" @onclick="() => ViewPly(0)" disabled="@(_session.PlyCount == 0)" title="Đầu ván">⏮</button>
            <button class="ibtn ibtn-sm" @onclick="() => ViewPly(CurPly - 1)" disabled="@(CurPly <= 0)" title="Lùi">◀</button>
            <button class="ibtn ibtn-sm" @onclick="() => ViewPly(CurPly + 1)" disabled="@(CurPly >= _session.PlyCount)" title="Tới">▶</button>
            <button class="ibtn ibtn-sm" @onclick="() => ViewPly(_session.PlyCount)" disabled="@(_viewPly < 0)" title="Mới nhất">⏭</button>
            @if (_viewPly >= 0)
            {
                <span class="hint">đang xem nước @_viewPly</span>
            }
        </div>

        <details class="cfg">
            <summary>Tuỳ chỉnh</summary>
            @if (_modePick.StartsWith("ai-"))
            {
                <label class="field">
                    Độ khó của máy
                    <select @bind="_aiDepth" class="form-select form-select-sm">
                        <option value="1">Yếu (depth 1)</option>
                        <option value="2">Vừa (depth 2)</option>
                        <option value="3">Khá (depth 3)</option>
                    </select>
                </label>
            }
            <label class="field">
                Quân cờ
                <select @bind="_pieceTheme" @bind:after="ApplyPieceTheme" class="form-select form-select-sm">
                    <option value="classic">Cổ điển</option>
                    <option value="modern">Hiện đại</option>
                    <option value="metal">Kim loại</option>
                </select>
            </label>
            <div class="field">
                <span>Dàn thế cờ (FEN)</span>
                <div class="fen-row">
                    <input class="form-control form-control-sm" @bind="_fenInput" @bind:event="oninput"
                           @onkeydown="FenKey" placeholder="để trống = bàn đầu" />
                    <button class="ibtn ibtn-wide" @onclick="SetupFen">Dàn cờ</button>
                </div>
            </div>
            @if (_fenError)
            {
                <div class="fen-err">FEN không hợp lệ.</div>
            }
        </details>
            </div>
        </div>
    </div>
</div>

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Chess>? _dotNet;
    private readonly GameSession _session = new();
    private readonly SimpleAi _ai = new();
    private string _modePick = "2p";
    private string _tcPick = "none";
    private string _pieceTheme = "classic";
    private bool _aiThinking;
    private bool _flipped;
    private bool _confirmResign;
    private bool _confirmDraw;
    private bool _confirmNew;
    private bool _panelPinned;

    private void TogglePanel() => _panelPinned = !_panelPinned;
    private bool _drawDeclined;
    private int _aiDepth = 3;
    private int _viewPly = -1; // -1 = live board, >=0 = reviewing that ply
    private string _fenInput = "";
    private bool _fenError;
    private int CurPly => _viewPly < 0 ? _session.PlyCount : _viewPly;

    // eval bar: white win% mapped from centipawns
    private int EvalPct()
    {
        var cp = SimpleAi.EvaluateBoard(_session.Position);
        var pct = 50 + cp / 40.0; // ±2000cp -> 0..100
        return (int)Math.Clamp(pct, 2, 98);
    }
    private string EvalText()
    {
        var cp = SimpleAi.EvaluateBoard(_session.Position);
        var pawns = cp / 100.0;
        return pawns >= 0 ? $"+{pawns:0.0}" : $"{pawns:0.0}";
    }
    // dev cache-bust: per-mount query guarantees a fresh module after edits
    private static readonly string _scriptVer = DateTimeOffset.Now.ToUnixTimeMilliseconds().ToString();

    // ---- clock state (ms remaining per side) ----
    private double _whiteMs, _blackMs, _incMs;
    private DateTime _lastTick;
    private bool _clockStarted;
    private PeriodicTimer? _clockTimer;

    private bool ClockOn => _tcPick != "none";
    private int TopMs => (int)Math.Max(0, _flipped ? _whiteMs : _blackMs);
    private int BottomMs => (int)Math.Max(0, _flipped ? _blackMs : _whiteMs);
    private bool TopClockHot => ClockOn && !_session.IsGameOver && _clockStarted && _session.WhiteToMove == _flipped;
    private bool BottomClockHot => ClockOn && !_session.IsGameOver && _clockStarted && _session.WhiteToMove == !_flipped;

    private static string Fmt(int ms)
    {
        var t = TimeSpan.FromMilliseconds(ms);
        return t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes}:{t.Seconds:00}"
             : $"{t.Seconds}.{t.Milliseconds / 100}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        for (var attempt = 0; attempt < 3 && _module is null; attempt++)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./_content/htchess.Shared/js/chess3d.js?v={_scriptVer}");
            }
            catch (JSException)
            {
                if (attempt == 2) return;
                await Task.Delay(400);
            }
        }
        _dotNet = DotNetObjectReference.Create(this);
        await Js("initScene", _canvas, _dotNet);
        try
        {
            var t = await _module!.InvokeAsync<string>("getPieceTheme");
            if (!string.IsNullOrEmpty(t) && t != _pieceTheme)
            {
                _pieceTheme = t;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSException) { }
        _ = RunClock();
    }

    private async Task RunClock()
    {
        _clockTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
        _lastTick = DateTime.UtcNow;
        try
        {
            while (await _clockTimer.WaitForNextTickAsync())
            {
                var now = DateTime.UtcNow;
                var elapsed = (now - _lastTick).TotalMilliseconds;
                _lastTick = now;
                if (!ClockOn || _session.IsGameOver || !_clockStarted) continue;
                if (_session.WhiteToMove) _whiteMs -= elapsed; else _blackMs -= elapsed;
                if (_whiteMs <= 0 || _blackMs <= 0)
                {
                    _session.Flag(_whiteMs <= 0);
                    await Js("playSound", "end");
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task SceneReady()
    {
        await SyncBoard();
    }

    [JSInvokable]
    public string DebugState() => System.Text.Json.JsonSerializer.Serialize(new
    {
        mode = _session.Mode.ToString(), humanWhite = _session.HumanIsWhite,
        whiteToMove = _session.WhiteToMove, stmHuman = _session.SideToMoveIsHuman,
        selected = _session.Selected, targets = _session.SelectedTargets,
        preFrom = _session.PremoveFrom, preTo = _session.PremoveTo,
        ply = _session.PlyCount, over = _session.IsGameOver,
    });

    [JSInvokable]
    public async Task RightClicked()
    {
        _confirmResign = _confirmDraw = _confirmNew = false;
        _session.ClearSelection();
        await PushHighlights();
    }

    [JSInvokable]
    public async Task NavKey(string dir)
    {
        var target = dir switch
        {
            "start" => 0,
            "end" => _session.PlyCount,
            "prev" => CurPly - 1,
            "next" => CurPly + 1,
            _ => CurPly,
        };
        await ViewPly(target);
    }

    [JSInvokable]
    public async Task SquareClicked(string square)
    {
        if (_viewPly >= 0) return; // board is read-only while reviewing
        var outcome = _session.Click(square);
        _confirmResign = _confirmDraw = _confirmNew = false;
        switch (outcome.Result)
        {
            case ClickResult.Selected:
                await Js("playSound", "select");
                await PushHighlights();
                break;
            case ClickResult.Deselected:
                await PushHighlights();
                break;
            case ClickResult.PremoveSelect:
            case ClickResult.PremoveSet:
                await Js("playSound", "select");
                await PushHighlights();
                break;
            case ClickResult.NeedsPromotion:
                StateHasChanged(); // show promo overlay
                break;
            case ClickResult.MoveApplied:
                await AfterMove(outcome.Move!);
                break;
        }
    }

    private async Task CancelPromo()
    {
        _session.CancelPromotion();
        await PushHighlights();
    }

    private async Task PickPromo(string promo)
    {
        var outcome = _session.ResolvePromotion(promo);
        if (outcome?.Result == ClickResult.MoveApplied)
            await AfterMove(outcome.Move!);
    }

    private async Task AfterMove(AppliedMove m)
    {
        _viewPly = -1; // new move jumps back to live position
        _clockStarted = true;
        // increment goes to the side that just moved (opposite of side to move now)
        if (ClockOn) { if (_session.WhiteToMove) _blackMs += _incMs; else _whiteMs += _incMs; }
        await Js("applyMove", m.From, m.To,
            new { capturedSquare = m.CapturedSquare, rookFrom = m.RookFrom, rookTo = m.RookTo, promoteTo = m.PromoteTo });
        await Js("setCaptured", _session.CapturedByBlack(), _session.CapturedByWhite());
        await PlayMoveSound(m);
        await PushHighlights();
        await MaybeAiMove();
    }

    private async Task PlayMoveSound(AppliedMove m)
    {
        if (_session.IsGameOver) { await Js("playSound", "end"); return; }
        var kind = m.CapturedSquare is not null ? "capture"
                 : m.PromoteTo is not null ? "promote"
                 : m.RookFrom is not null ? "castle" : "move";
        await Js("playSound", kind);
        if (_session.IsCheck) await Js("playSound", "check");
    }

    private async Task MaybeAiMove()
    {
        if (_session.Mode != GameMode.VsAi || _session.SideToMoveIsHuman || _session.IsGameOver) { await TryPremove(); return; }
        _aiThinking = true;
        StateHasChanged();
        var move = await _ai.FindBestAsync(_session.Position, _aiDepth);
        _aiThinking = false;
        if (move is not null && !_session.IsGameOver)
        {
            var applied = _session.ApplyMove(move.Value);
            await AfterMove(applied);
            return;
        }
        StateHasChanged();
    }

    /// If it's the human's turn and a premove is queued, fire it.
    private async Task TryPremove()
    {
        var applied = _session.TryPlayPremove();
        if (applied is not null) await AfterMove(applied);
        else await PushHighlights(); // half premove may have become a normal selection
    }

    private async Task SyncBoard()
    {
        _viewPly = -1;
        await SyncPieces();
        await PushHighlights();
        await MaybeAiMove();
    }

    private async Task SyncPieces()
    {
        var pieces = _session.GetPosition().Select(p => new { square = p.Square, type = p.Type, color = p.Color });
        await Js("setPieces", pieces);
        await Js("setCaptured", _session.CapturedByBlack(), _session.CapturedByWhite());
    }

    /// Show the board as of ply `ply` (-1/PlyCount = live). Read-only while viewing.
    private async Task ViewPly(int ply)
    {
        _viewPly = ply >= _session.PlyCount ? -1 : Math.Max(0, ply);
        if (_viewPly >= 0)
        {
            var pieces = _session.PiecesAt(_viewPly).Select(p => new { square = p.Square, type = p.Type, color = p.Color });
            await Js("setPieces", pieces);
            await Js("setCaptured", _session.CapturedByBlack(_viewPly), _session.CapturedByWhite(_viewPly));
        }
        else await SyncPieces();
        await PushHighlights();
    }

    private async Task SetupFen()
    {
        _fenError = false;
        try
        {
            var (mode, humanWhite) = _modePick switch
            {
                "ai-w" => (GameMode.VsAi, true),
                "ai-b" => (GameMode.VsAi, false),
                _ => (GameMode.TwoPlayer, true),
            };
            var fen = _fenInput.Trim();
            if (fen.Length == 0) _session.NewGame(mode, humanWhite);
            else _session.NewGameFromFen(fen, mode, humanWhite);
        }
        catch (Exception) { _fenError = true; return; }
        _confirmResign = _confirmDraw = _confirmNew = _drawDeclined = false;
        ResetClock();
        _flipped = _session.Mode == GameMode.VsAi && !_session.HumanIsWhite;
        await Js("setOrientation", !_flipped);
        await SyncBoard();
    }

    private async Task ApplyPieceTheme() => await Js("setPieceTheme", _pieceTheme);

    private async Task FenKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SetupFen();
    }

    [JSInvokable]
    public async Task DebugSetupFen(string fen)
    {
        _fenInput = fen;
        await SetupFen();
    }

    private async Task PushHighlights()
    {
        string[]? lastMove = null;
        if (_viewPly > 0)
        {
            var ms = _session.MoveSquaresOf(_viewPly - 1);
            if (ms is not null) lastMove = new[] { ms.Value.From, ms.Value.To };
        }
        else if (_viewPly < 0 && _session.LastFrom is not null)
            lastMove = new[] { _session.LastFrom, _session.LastTo! };
        await Js("setHighlights", new
        {
            selected = _viewPly < 0 ? _session.Selected : null,
            targets = _viewPly < 0 ? _session.SelectedTargets.ToArray() : Array.Empty<string>(),
            check = _viewPly < 0 ? _session.CheckedKingSquare() : null,
            lastMove,
            premove = _viewPly < 0 && _session.PremoveFrom is not null
                ? new[] { _session.PremoveFrom, _session.PremoveTo }.Where(x => x is not null).ToArray()
                : null,
        });
        StateHasChanged();
    }

    private async Task Js(string fn, params object?[] args)
    {
        if (_module is null) return;
        try { await _module.InvokeVoidAsync(fn, args); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private CancellationTokenSource? _confirmCts;

    /// Armed two-step confirms expire so a stale arm can't fire later.
    private async void ArmExpire()
    {
        _confirmCts?.Cancel();
        var cts = _confirmCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(4000, cts.Token);
            _confirmResign = _confirmDraw = _confirmNew = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task NewGameClick()
    {
        // mid-game resets are destructive: same two-step affordance as resign/draw
        var midGame = _session.PlyCount > 0 && !_session.IsGameOver;
        if (midGame && !_confirmNew)
        {
            _confirmNew = true;
            _confirmResign = _confirmDraw = false;
            ArmExpire();
            return;
        }
        await NewGame();
    }

    private async Task NewGame()
    {
        var (mode, humanWhite) = _modePick switch
        {
            "ai-w" => (GameMode.VsAi, true),
            "ai-b" => (GameMode.VsAi, false),
            _ => (GameMode.TwoPlayer, true),
        };
        _session.NewGame(mode, humanWhite);
        _confirmResign = _confirmDraw = _confirmNew = _drawDeclined = false;
        _fenError = false;
        _fenInput = ""; // a new game leaves any stale FEN text incoherent with the board
        ResetClock();
        // vs AI the human always sits at the bottom
        _flipped = mode == GameMode.VsAi && !humanWhite;
        await Js("setOrientation", !_flipped);
        await SyncBoard();
    }

    private void ResetClock()
    {
        var (start, inc) = ParseTc(_tcPick);
        _whiteMs = _blackMs = start; _incMs = inc;
        _lastTick = DateTime.UtcNow;
        _clockStarted = false; // clock starts on the first move
    }

    private static (double start, double inc) ParseTc(string tc) => tc switch
    {
        "1+0" => (60_000, 0), "3+0" => (180_000, 0), "3+2" => (180_000, 2_000),
        "5+0" => (300_000, 0), "5+3" => (300_000, 3_000), "10+0" => (600_000, 0),
        _ => (0, 0),
    };

    private async Task ResignClick()
    {
        if (!_confirmResign) { _confirmResign = true; _confirmDraw = _confirmNew = false; ArmExpire(); return; }
        _confirmResign = false;
        _session.Resign();
        await Js("playSound", "end");
        await PushHighlights();
    }

    private async Task DrawClick()
    {
        if (!_confirmDraw) { _confirmDraw = true; _confirmResign = _confirmNew = false; _drawDeclined = false; ArmExpire(); return; }
        _confirmDraw = false;
        if (_session.OfferDraw()) { await Js("playSound", "end"); }
        else _drawDeclined = true;
        await PushHighlights();
    }

    private async Task Undo()
    {
        _session.Undo();
        await SyncBoard();
    }

    private async Task Flip()
    {
        _flipped = !_flipped;
        await Js("flipBoard");
    }

    private string Pgn()
    {
        var sb = new System.Text.StringBuilder();
        var hist = _session.History;
        for (var i = 0; i < hist.Count; i++)
        {
            if (i % 2 == 0) sb.Append(i / 2 + 1).Append(". ");
            sb.Append(hist[i].San).Append(' ');
        }
        sb.Append(_session.ResultTag ?? "*");
        return sb.ToString();
    }

    private bool _copied;

    private async Task CopyPgn()
    {
        await Js("copyText", Pgn());
        _copied = true;
        _ = Task.Delay(1500).ContinueWith(_ => { _copied = false; InvokeAsync(StateHasChanged); });
    }

    private static readonly Dictionary<char, string> Glyphs = new()
    {
        ['Q'] = "♛", ['R'] = "♜", ['B'] = "♝", ['N'] = "♞", ['P'] = "♟",
        ['q'] = "♕", ['r'] = "♖", ['b'] = "♗", ['n'] = "♘", ['p'] = "♙",
    };
    private static string Sym(string t) => Glyphs.TryGetValue(t[0], out var g) ? g : t;

    /// "♜ ♞ ♟×3 +2" — grouped glyphs with counts and the material lead.
    private static string CapLine(List<string> pieces, int diff)
    {
        if (pieces.Count == 0 && diff == 0) return "—";
        var order = new Dictionary<string, int> { ["q"] = 0, ["r"] = 1, ["b"] = 2, ["n"] = 3, ["p"] = 4 };
        var s = string.Join(" ", pieces
            .GroupBy(t => t)
            .OrderBy(g => order.TryGetValue(g.Key.ToLowerInvariant(), out var o) ? o : 9)
            .Select(g => Sym(g.Key) + (g.Count() > 1 ? $"×{g.Count()}" : "")));
        return diff > 0 ? $"{s} +{diff}" : s;
    }

    private static int PieceVal(string t) => char.ToUpperInvariant(t[0]) switch
    {
        'Q' => 9, 'R' => 5, 'B' => 3, 'N' => 3, _ => 1,
    };

    /// Material lead in pawns from white's perspective.
    private int MaterialDiff() =>
        _session.CapturedByWhite().Sum(PieceVal) - _session.CapturedByBlack().Sum(PieceVal);

    private string StatusText()
    {
        if (_session.IsGameOver) return _session.GameOverReason ?? "Hết ván";
        var side = _session.WhiteToMove ? "Trắng" : "Đen";
        var check = _session.IsCheck ? " — CHIẾU!" : "";
        var pre = _session.PremoveFrom is not null ? " (premove)" : "";
        return $"Lượt: {side}{check}{pre}";
    }

    public async ValueTask DisposeAsync()
    {
        _clockTimer?.Dispose();
        await Js("dispose");
        _dotNet?.Dispose();
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
